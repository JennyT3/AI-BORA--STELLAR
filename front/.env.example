# AI BORA Frontend - Environment Variables Template
# Copy to front/.env.local and fill in your values.
# Only VITE_* vars are exposed to the browser. Never put secrets here.

# ============================================
# FIREBASE (client-side SDK)
# ============================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# BACKEND API
# ============================================
# Leave empty in production (requests go to /api via the Vercel rewrite).
# Point to the local backend during development, e.g. http://localhost:3001
VITE_API_URL=

# ============================================
# POLLAR (client-side SDK)
# ============================================
# Publishable key from https://dashboard.pollar.xyz (Build → API Keys).
# Only exposes the browser flow (login, wallet, SEP-24 ramps). Safe to embed.
VITE_POLLAR_PUBLIC_KEY=pk_testnet_xxxxxxxxxxxxxxxxxxxx
