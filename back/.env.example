# AI BORA Backend - Environment Variables Template
# Copy to back/.env.local and fill in your values.
# These are server-only secrets (Vercel environment). Never expose via VITE_*.

# ============================================
# STELLAR BLOCKCHAIN
# ============================================
# Vendor account that receives payments and signs contract calls.
VENDOR_SECRET=YOUR_STELLAR_SECRET_KEY_HERE
VENDOR_PUBLIC=YOUR_STELLAR_PUBLIC_KEY_HERE

# Admin account used to anchor proposals on-chain.
STELLAR_ADMIN_SECRET=YOUR_STELLAR_ADMIN_SECRET_KEY_HERE
STELLAR_ADMIN_PUBLIC=YOUR_STELLAR_ADMIN_PUBLIC_KEY_HERE

# USDC issuer used by /api/stellar-pay (mainnet default).
USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Soroban proposal registry contract ID.
PROPOSAL_REGISTRY_CONTRACT=YOUR_CONTRACT_ID_HERE

# Soroban PaymentSplitter contract ID (70/30 split).
PAYMENT_SPLITTER_CONTRACT=CCP4JPWI33BC2XCDOLEDOIURMP7NPBY7I532H4N56ZDBCXX3A6BZNZ3P

# Soroban USDC token contract ID. Required to execute the on-chain split.
USDC_CONTRACT_ID=YOUR_USDC_SOROBAN_CONTRACT_ID_HERE

# Shared secret required to call /api/sign-and-submit.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=replace_me_with_openssl_rand_hex_32

# ============================================
# FIREBASE (server-side admin SDK)
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# EMAIL
# ============================================
RESEND_API_KEY=re_your_resend_key

# ============================================
# POLLAR (server-side integration)
# ============================================
# Secret key from https://dashboard.pollar.xyz (Build → API Keys).
# Starts with "sec_". Used for user/custodial-wallet provisioning and
# token verification (Pollar Server API). Never expose via VITE_*.
POLLAR_SECRET_KEY=sec_testnet_xxxxxxxxxxxxxxxxxxxx

# ============================================
# APP
# ============================================
# Public URL used to build client magic links.
APP_URL=https://aibora.pt
